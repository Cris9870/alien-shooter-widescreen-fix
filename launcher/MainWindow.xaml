<Window x:Class="AlienShooterLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alien Shooter" Width="1240" Height="780"
        WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="Black" Icon="Assets/icon.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <FontFamily x:Key="Stencil">Bahnschrift SemiBold Condensed, Impact, Arial Narrow</FontFamily>
        <FontFamily x:Key="Body">Bahnschrift, Segoe UI</FontFamily>
        <SolidColorBrush x:Key="RedText" Color="#FF4A36"/>
        <SolidColorBrush x:Key="DimText" Color="#8C949B"/>
        <SolidColorBrush x:Key="PaleText" Color="#C9CED2"/>

        <LinearGradientBrush x:Key="Steel" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8A9199" Offset="0"/>
            <GradientStop Color="#40464C" Offset="0.45"/>
            <GradientStop Color="#1D2125" Offset="0.55"/>
            <GradientStop Color="#666D75" Offset="1"/>
        </LinearGradientBrush>

        <!-- Dark grid like the in-game equipment screen -->
        <DrawingBrush x:Key="GridPanel" TileMode="Tile" Viewport="0,0,18,18" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#EC090C0E">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,18,18"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#16262A" Thickness="1"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <DrawingBrush x:Key="Hazard" TileMode="Tile" Viewport="0,0,14,14" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#121212" Geometry="M0,0 H14 V14 H0 Z"/>
                    <GeometryDrawing Brush="#D9A900" Geometry="M0,14 L7,0 H14 L7,14 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <LinearGradientBrush x:Key="RedIdle" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3E0805" Offset="0"/>
            <GradientStop Color="#160201" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RedHot" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8A1309" Offset="0"/>
            <GradientStop Color="#3A0603" Offset="1"/>
        </LinearGradientBrush>
        <DropShadowEffect x:Key="Glow" Color="#FF2A14" BlurRadius="16" ShadowDepth="0" Opacity="0.85"/>
        <DropShadowEffect x:Key="TextGlow" Color="#FF2010" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>

        <!-- Red bevelled button like the game's menu buttons -->
        <Style x:Key="GameButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FF5A45"/>
            <Setter Property="FontFamily" Value="{StaticResource Stencil}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Padding" Value="14,6"/>
            <EventSetter Event="MouseEnter" Handler="OnHover"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Canvas x:Name="Bg">
                                <Path x:Name="Shape" Data="M0,0 H100 V62 L86,100 H0 Z" Stretch="Fill"
                                      Width="{Binding ActualWidth, ElementName=Bg}" Height="{Binding ActualHeight, ElementName=Bg}"
                                      StrokeThickness="1.5" Stroke="#B5261A" Fill="{StaticResource RedIdle}"/>
                            </Canvas>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shape" Property="Stroke" Value="#FF5A42"/>
                                <Setter TargetName="Shape" Property="Fill" Value="{StaticResource RedHot}"/>
                                <Setter TargetName="Shape" Property="Effect" Value="{StaticResource Glow}"/>
                                <Setter Property="Foreground" Value="#FFE2D8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shape" Property="Fill" Value="#5A0C06"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Selectable option (resolution, zoom...) -->
        <Style x:Key="GameChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E0453A"/>
            <Setter Property="FontFamily" Value="{StaticResource Stencil}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Width" Value="98"/>
            <Setter Property="Height" Value="50"/>
            <EventSetter Event="MouseEnter" Handler="OnHover"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Canvas x:Name="Bg">
                                <Path x:Name="Shape" Data="M0,0 H100 V68 L90,100 H0 Z" Stretch="Fill"
                                      Width="{Binding ActualWidth, ElementName=Bg}" Height="{Binding ActualHeight, ElementName=Bg}"
                                      StrokeThickness="1.5" Stroke="#5A1A14" Fill="#C0100C0B"/>
                            </Canvas>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,4"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shape" Property="Stroke" Value="#D8392A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shape" Property="Stroke" Value="#FF5A42"/>
                                <Setter TargetName="Shape" Property="Fill" Value="{StaticResource RedHot}"/>
                                <Setter TargetName="Shape" Property="Effect" Value="{StaticResource Glow}"/>
                                <Setter Property="Foreground" Value="#FFE8DE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Steel switch with a red LED -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PaleText}"/>
            <Setter Property="FontFamily" Value="{StaticResource Body}"/>
            <Setter Property="FontSize" Value="13"/>
            <EventSetter Event="MouseEnter" Handler="OnHover"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="62" Height="28">
                                <Border x:Name="Track" CornerRadius="3" Background="#111518"
                                        BorderBrush="{StaticResource Steel}" BorderThickness="2"/>
                                <Ellipse x:Name="Led" Width="9" Height="9" Fill="#3A0D0A"
                                         HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                <Border x:Name="Knob" Width="24" Height="20" Margin="4,0" CornerRadius="2"
                                        HorizontalAlignment="Left" Background="{StaticResource Steel}"/>
                            </Grid>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Led" Property="HorizontalAlignment" Value="Left"/>
                                <Setter TargetName="Led" Property="Margin" Value="10,0,0,0"/>
                                <Setter TargetName="Led" Property="Fill" Value="#FF3B2A"/>
                                <Setter TargetName="Led" Property="Effect" Value="{StaticResource Glow}"/>
                                <Setter TargetName="Track" Property="Background" Value="#380805"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Stencil}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource RedText}"/>
            <Setter Property="Margin" Value="0,14,0,8"/>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="#9AA1A8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#7A140C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Steel}" BorderThickness="3">
        <Grid x:Name="Root" ClipToBounds="True">
            <!-- Background: red-lit corridor, read from the player's game folder -->
            <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="0.6"/>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#55000000" Offset="0"/>
                        <GradientStop Color="#99000000" Offset="0.4"/>
                        <GradientStop Color="#EE000000" Offset="0.62"/>
                        <GradientStop Color="#F5030405" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle x:Name="RedGlow" Opacity="0.5" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.2,0.62" GradientOrigin="0.2,0.62" RadiusX="0.45" RadiusY="0.6">
                        <GradientStop Color="#70FF1A0A" Offset="0"/>
                        <GradientStop Color="#00FF1A0A" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Security camera showing the game's loading screens (from the player's copy) -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,292,0,0" Width="548" Height="413"
                    BorderBrush="{StaticResource Steel}" BorderThickness="4" Background="Black">
                <Grid ClipToBounds="True">
                    <Image x:Name="CamA" Stretch="UniformToFill"/>
                    <Image x:Name="CamB" Stretch="UniformToFill" Opacity="0"/>
                    <TextBlock x:Name="NoSignal" Text="SIN SEÑAL" Visibility="Collapsed" FontSize="34"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{StaticResource Stencil}" Foreground="#5A6066"/>
                    <Rectangle IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,4,3" ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="#00000000" Geometry="M0,0 H4 V3 H0 Z"/>
                                        <GeometryDrawing Brush="#55000000" Geometry="M0,2 H4 V3 H0 Z"/>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <RadialGradientBrush RadiusX="0.75" RadiusY="0.75">
                                <GradientStop Color="#00000000" Offset="0.55"/>
                                <GradientStop Color="#C0000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <StackPanel Orientation="Horizontal" Margin="14,10" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Ellipse x:Name="RecDot" Width="11" Height="11" Fill="#FF2A1A" Effect="{StaticResource Glow}"/>
                        <TextBlock Text="REC" Margin="7,0,0,0" FontFamily="{StaticResource Stencil}" FontSize="16"
                                   Foreground="#E8E2DE" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="CamLabel" Margin="14,8" HorizontalAlignment="Right" VerticalAlignment="Top"
                               FontFamily="{StaticResource Stencil}" FontSize="16" Foreground="#E8E2DE"/>
                    <TextBlock x:Name="CamClock" Margin="14,8" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                               FontFamily="Consolas" FontSize="14" Foreground="#C8D0D4"/>
                    <TextBlock Text="LABORATORIO · NIVEL -3" Margin="14,8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               FontFamily="{StaticResource Stencil}" FontSize="14" Foreground="#A9B0B5"/>
                </Grid>
            </Border>

            <!-- Logo, read from the player's game folder -->
            <Image x:Name="LogoImage" HorizontalAlignment="Left" VerticalAlignment="Top"
                   Width="400" Margin="44,52,0,0" IsHitTestVisible="False">
                <Image.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="0" Opacity="1"/>
                </Image.Effect>
            </Image>

            <!-- Title bar -->
            <Grid VerticalAlignment="Top" Height="34" Background="#01000000" MouseLeftButtonDown="OnTitleDrag">
                <TextBlock Text="ALIEN SHOOTER  ·  LAUNCHER" Margin="16,0,0,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource Stencil}" FontSize="14" Foreground="#7E868D"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WindowButton}" Content="—" Click="OnMinimize"/>
                    <Button Style="{StaticResource WindowButton}" Content="✕" Click="OnClose"/>
                </StackPanel>
            </Grid>

            <!-- Version / status bottom-left -->
            <TextBlock x:Name="StatusText" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,14"
                       MaxWidth="560" TextWrapping="Wrap"
                       FontFamily="{StaticResource Body}" FontSize="12" Foreground="#A7AEB4">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="0" Opacity="1"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- Control panel -->
            <Border HorizontalAlignment="Right" Width="590" Margin="0,46,26,24"
                    Background="{StaticResource GridPanel}" BorderBrush="{StaticResource Steel}" BorderThickness="3">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="42" Background="#E6121619"
                            BorderBrush="#30373C" BorderThickness="0,0,0,1">
                        <Grid Margin="18,0">
                            <TextBlock Text="PANEL DE CONTROL" VerticalAlignment="Center" FontSize="20"
                                       FontFamily="{StaticResource Stencil}" Foreground="{StaticResource RedText}"
                                       Effect="{StaticResource TextGlow}"/>
                            <Rectangle Fill="{StaticResource Hazard}" Width="120" Height="10"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Play + footer -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="22,0,22,16">
                        <Button x:Name="PlayButton" Style="{StaticResource GameButton}" Height="76" Click="OnPlay"
                                FontSize="40" Padding="0">
                            <TextBlock Text="J U G A R" Effect="{StaticResource TextGlow}"/>
                        </Button>
                        <Grid Margin="0,12,0,0">
                            <TextBlock x:Name="RenderInfo" VerticalAlignment="Center" FontFamily="{StaticResource Body}"
                                       FontSize="12" Foreground="{StaticResource DimText}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GameButton}" FontSize="13" Padding="14,0" Height="32"
                                        Content="RESPALDAR PARTIDAS" Click="OnBackup" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource GameButton}" FontSize="13" Padding="14,0" Height="32"
                                        Content="CARPETA DEL JUEGO" Click="OnOpenFolder"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="22,4,22,0">
                        <Grid Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="MODO ALTA RESOLUCIÓN" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <TextBlock x:Name="EnabledHint" FontFamily="{StaticResource Body}" FontSize="12"
                                           Foreground="{StaticResource DimText}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="400" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <CheckBox x:Name="EnabledSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" Click="OnEnabledChanged"/>
                        </Grid>

                        <StackPanel x:Name="Options">
                            <TextBlock Text="PANTALLA" Style="{StaticResource SectionTitle}"/>
                            <WrapPanel x:Name="DisplayPanel"/>

                            <TextBlock Text="RESOLUCIÓN" Style="{StaticResource SectionTitle}"/>
                            <WrapPanel x:Name="OutputPanel"/>

                            <TextBlock Text="ZOOM" Style="{StaticResource SectionTitle}"/>
                            <WrapPanel x:Name="ZoomPanel"/>
                            <TextBlock FontFamily="{StaticResource Body}" FontSize="12" Foreground="{StaticResource DimText}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="Resolución interna del juego.  CERCA: personajes más grandes.  LEJOS: ves más mapa.  ★ recomendado."/>

                            <TextBlock Text="IMAGEN" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <WrapPanel x:Name="FilterPanel"/>
                                <CheckBox x:Name="ClipSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Top" Margin="0,10,0,0" Click="OnClipChanged"
                                          Content="Ratón fijo en la pantalla"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
