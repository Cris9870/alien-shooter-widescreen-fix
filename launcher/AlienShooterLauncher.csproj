<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 ships with Windows 10/11, so the launcher runs without installing anything. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>AlienShooterLauncher</AssemblyName>
    <RootNamespace>AlienShooterLauncher</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- Single source of truth: the VERSION file in the repo root (the updater compares it with the release tag). -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\VERSION').Trim())</Version>
    <Product>Alien Shooter Widescreen Fix</Product>
    <Description>Launcher del modo alta resolucion para Alien Shooter</Description>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <!-- The upscaler DLL travels inside the launcher and is installed into the game folder.
         Build upscaler\d3d9.dll first. Game art is NOT embedded: it is read from the player's copy. -->
    <EmbeddedResource Include="..\upscaler\d3d9.dll" LogicalName="d3d9.dll" />
  </ItemGroup>

</Project>
